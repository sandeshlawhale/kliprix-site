# Names only, never values. On Vercel these live in Project Settings -> Environment Variables;
# locally, `vercel env pull .env.local` writes them (.env*.local is git-ignored).

# Set by the "Upstash for Redis" Marketplace integration. Redis.fromEnv() reads these
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN for a database created on upstash.com).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Also set by the integration, not used by the site:
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
# REDIS_URL=

# Long random string. Client IPs are hashed with it for the /api/track rate limit and never stored.
IP_HASH_SALT=

# Password for the private /stats page (HTTP Basic Auth, any username). Unset: /stats is locked.
STATS_PASSWORD=

# Optional: a GitHub token (no scopes needed) so /stats does not hit the 60 requests/hour limit.
GITHUB_TOKEN=
